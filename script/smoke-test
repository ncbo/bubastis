#!/usr/bin/env bash
# Runs a built bubastis jar on two tiny ontologies and checks the report.
# Bubastis exits 0 even when a diff fails, so the report is what's checked.
# Usage: script/smoke-test path/to/bubastis.jar
set -euo pipefail
jar=${1:?usage: script/smoke-test path/to/bubastis.jar}
dir=$(cd "$(dirname "$0")/../test/smoke" && pwd)
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

java -jar "$jar" -ontology1 "$dir/v1.owl" -ontology2 "$dir/v2.owl" \
  -output "$out/diff.xml" -format xml
test -s "$out/diff.xml" || { echo "FAIL: no report written"; exit 1; }
tr -d '[:space:]' < "$out/diff.xml" | grep -q '<numberNewClasses>1</numberNewClasses>' \
  || { echo "FAIL: expected 1 new class"; cat "$out/diff.xml"; exit 1; }
grep -q 'http://example.org/smoke#Dog' "$out/diff.xml" \
  || { echo "FAIL: new class Dog not reported"; cat "$out/diff.xml"; exit 1; }
echo "OK: $jar reports the new class"
